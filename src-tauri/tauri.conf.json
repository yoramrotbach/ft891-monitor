{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "891 Monitor",
  "version": "0.1.0",
  "identifier": "net.4z1yr.ft891monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "891 Monitor",
        "width": 900,
        "height": 430,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "CAT monitor and remote panel for the Yaesu FT-891",
    "longDescription": "Desktop display that mirrors the Yaesu FT-891 LCD over CAT: frequency, mode, meters and indicators, with basic remote control (tuning, mode, band, VFO and receive functions). It cannot key the transmitter.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
